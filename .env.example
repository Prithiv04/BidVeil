# BIDVEIL Environment Configuration Example
# Copy this file to .env and configure values for your deployment

# Flask secret key for session security (required for production)
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-here

# Optional: Custom temporary directory for document processing
# If not set, uses system default temporary directory
BIDVEIL_TEMP_DIR=/tmp/bidveil

# OpenAI AI evaluation. Set a real API key in your private .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# SQLite persistent evaluation records. Defaults to instance/bidveil.sqlite3.
# BIDVEIL_DB_PATH=C:/private/bidveil.sqlite3

# Optional U.S. SAM.gov public entity lookup (requires a SAM.gov Public API key).
# Vendors must enter their UEI before lookup; the key remains server-side.
# SAM_GOV_API_KEY=
